# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Локальный override зависимостей (путь к ../openrouter для разработки)
pubspec_overrides.yaml

# Secrets and local environment
.env
*.env.local

# Codegen (build_runner, gen-l10n): регенерируется командами из README
*.g.dart
*.gr.dart
*.freezed.dart
/lib/l10n/generated/

# Flutter/Dart/Pub related
**/build/
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/

# Snapcraft staging
/parts/
/prime/
/stage/
/snap/.snapcraft/
/.craft/
/*.snap

# Картинки расхождения golden-тестов: Flutter пишет их рядом с упавшим тестом.
test/**/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Временные артефакты тестов и ручных проверок
.rd*/
.tmp_*/
